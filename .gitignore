# --- Data: snapshots and derived frames are reproducible, never committed ---
# Leading slash anchors to the repo root: an unanchored `data/` would also
# match `src/data/`, silently excluding the ingestion package from commits.
/data/
*.db
*.sqlite
*.sqlite3

# --- Model artifacts and experiment tracking ---
/models/
/mlruns/
/mlartifacts/
*.pkl
*.joblib

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
/build/
/dist/

# --- Environments ---
.venv/
venv/
.env
.python-version

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
